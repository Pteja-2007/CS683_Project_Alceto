#include "cache.h"

#include <array>
#include <cstdint>
#include <iostream>

namespace {
constexpr uint32_t STREAM_COUNT = 16;
constexpr uint32_t MAX_DEGREE = 4;
constexpr uint64_t ACCURACY_SAMPLE_ISSUES = 64;
constexpr double HIGH_ACCURACY = 0.60;
constexpr double MEDIUM_ACCURACY = 0.35;

struct Stream {
  uint64_t next_line = 0;
  uint64_t page = 0;
  bool valid = false;
};

std::array<std::array<Stream, STREAM_COUNT>, NUM_CPUS> streams{};
std::array<uint32_t, NUM_CPUS> replace_stream{};
std::array<uint64_t, NUM_CPUS> last_demand_line{};
std::array<bool, NUM_CPUS> has_last_demand{};

std::array<uint64_t, NUM_CPUS> sampled_lower_level{};
std::array<uint64_t, NUM_CPUS> sampled_useful{};
std::array<uint64_t, NUM_CPUS> interval_issued{};
std::array<uint8_t, NUM_CPUS> degree{};

inline uint64_t page_of_line(uint64_t line)
{
  return (line << LOG2_BLOCK_SIZE) >> LOG2_PAGE_SIZE;
}

void issue_stream(CACHE *cache, uint64_t ip, uint64_t base_addr,
                  uint64_t first_line)
{
  const uint64_t base_page = base_addr >> LOG2_PAGE_SIZE;

  for (uint32_t d = 0; d < degree[cache->cpu]; ++d) {
    const uint64_t line = first_line + d;
    if (page_of_line(line) != base_page)
      break;

    const bool accepted = cache->prefetch_line(
        ip, base_addr, line << LOG2_BLOCK_SIZE,
        d == 0 ? FILL_L1 : FILL_L2, 0);

    if (!accepted)
      break;

    ++interval_issued[cache->cpu];
  }
}

void update_degree(CACHE *cache)
{
  const uint32_t cpu = cache->cpu;
  if (cache->pf_lower_level < sampled_lower_level[cpu]) {
// Handle counter reset/wrap defensively.
    sampled_lower_level[cpu] = cache->pf_lower_level;
    sampled_useful[cpu] = cache->pf_useful;
    interval_issued[cpu] = 0;
    return;
  }

  if (cache->pf_lower_level - sampled_lower_level[cpu] < ACCURACY_SAMPLE_ISSUES)
    return;

  const uint64_t useful_delta = cache->pf_useful >= sampled_useful[cpu]
                                    ? cache->pf_useful - sampled_useful[cpu]
                                    : 0;
  const double accuracy = interval_issued[cpu] == 0
                              ? 0.0
                              : static_cast<double>(useful_delta) /
                                    static_cast<double>(interval_issued[cpu]);

  if (accuracy >= HIGH_ACCURACY)
    degree[cpu] = MAX_DEGREE;
  else if (accuracy >= MEDIUM_ACCURACY)
    degree[cpu] = 2;
  else
    degree[cpu] = 1;

  sampled_lower_level[cpu] = cache->pf_lower_level;
  sampled_useful[cpu] = cache->pf_useful;
  interval_issued[cpu] = 0;
}
}

void CACHE::l1d_prefetcher_initialize()
{
  streams[cpu] = {};
  replace_stream[cpu] = 0;
  last_demand_line[cpu] = 0;
  has_last_demand[cpu] = false;
  sampled_lower_level[cpu] = pf_lower_level;
  sampled_useful[cpu] = pf_useful;
  interval_issued[cpu] = 0;
  degree[cpu] = 2;

  std::cout << "Global stream prefetcher (initial degree 2, max degree "
            << MAX_DEGREE << ")\n";
}

void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip,
                                  uint8_t cache_hit, uint8_t type,
                                  uint8_t critical_ip_flag)
{
  if (type == PREFETCH)
    return;

  update_degree(this);

  const uint64_t line = addr >> LOG2_BLOCK_SIZE;
  const uint64_t page = addr >> LOG2_PAGE_SIZE;
  bool continued = false;

  for (auto &stream : streams[cpu]) {
    if (!stream.valid)
      continue;

    if (stream.page != page) {
      stream.valid = false;
      continue;
    }

    if (stream.next_line == line) {
      continued = true;
      stream.next_line = line + 1;
      issue_stream(this, ip, addr, line + 1);
    }
  }

  if (!continued && has_last_demand[cpu] &&
      line == last_demand_line[cpu] + 1 && page_of_line(line) == page) {
    Stream &stream = streams[cpu][replace_stream[cpu]];
    stream.next_line = line + 1;
    stream.page = page;
    stream.valid = true;
    replace_stream[cpu] = (replace_stream[cpu] + 1) % STREAM_COUNT;
    issue_stream(this, ip, addr, line + 1);
  }

  last_demand_line[cpu] = line;
  has_last_demand[cpu] = true;
}

void CACHE::l1d_prefetcher_cache_fill(uint64_t v_addr, uint64_t addr,
                                     uint32_t set, uint32_t way,
                                     uint8_t prefetch,
                                     uint64_t v_evicted_addr,
                                     uint64_t evicted_addr,
                                     uint32_t metadata_in) {}

void CACHE::l1d_prefetcher_notify_about_dtlb_eviction(
    uint64_t addr, uint32_t set, uint32_t way, uint8_t prefetch,
    uint64_t evicted_addr, uint32_t metadata_in) {}

void CACHE::l1d_prefetcher_final_stats()
{
  std::cout << "CPU " << cpu << " global stream degree: "
            << static_cast<unsigned>(degree[cpu]) << std::endl;
}